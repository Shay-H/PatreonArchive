APP_NAME="Patreon Archive"
DATABASE_URL="sqlite:///./data/patreon_archive.db"
DATA_ROOT="data"
RAW_ROOT="data/raw"

# Keep this private.
PATREON_COOKIE=""

# If installed globally:
PATREON_DL_COMMAND="patreon-dl"
# Or use npx:
# PATREON_DL_COMMAND="npx patreon-dl"

# Optional patreon-dl config file.
# PATREON_DL_CONFIG_FILE="example.conf"

# Optional TMDB API key for genre tagging.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# After a successful sync, delete downloaded image media under data/raw to
# reclaim space. patreon-dl's status cache keeps syncs incremental, so this
# never causes re-downloads. Set to "false" to keep the raw images.
PRUNE_RAW_MEDIA_AFTER_SYNC="true"

# Daily auto-refetch: re-syncs every known creator and tags new posts once a
# day. Pauses itself if a sync fails auth (the UI then prompts for a refresh).
AUTO_SYNC_ENABLED="true"
AUTO_SYNC_HOUR="3"          # hour of day, 0-23, container time (UTC)
# Creator name routed to the cinebingers scraper instead of patreon-dl.
CINEBINGERS_CREATOR_NAME="cinebingers"
