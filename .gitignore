__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit. Keep only the example.
.env
.env.*
!.env.example

# Archive data (DB + raw downloads, ~1.3GB) and transfer tarballs.
# data/homelib/ holds homelib's section config, which is tracked; its manifest
# lists are download links for paid content, so they stay out of this public repo.
data/*
!data/homelib/
data/homelib/*.txt
*.db
*.sqlite3
*.tar
*.tar.gz

# Logs & debug artifacts (may contain cookies/session data)
*.log
debug_out.txt
debug_err.txt
debug_response.html
